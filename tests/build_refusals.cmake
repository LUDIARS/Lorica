# SPEC-LR-VERIFY: Lorica's build functions refuse what they cannot apply instead of
# doing less (LR-BUILD-01, LR-BUILD-02, LR-BUILD-04), and injection applies what was
# asked. Each case configures a small project: a refusal must fail configuration
# with its text, a build error must fail the build with its text (for what
# configuration cannot see), and an applied case must configure and generate the
# expected Lorica target properties. Run with cmake -P:
#   -DLORICA_CMAKE_DIR=<cmake dir> -DWORK_DIR=<scratch> -DGENERATOR=<generator>
#   -DCXX_COMPILER=<compiler> -DGROUP=build|unsafe_api|harness_control
#   [-DEXTENDED=<bool>] [-DUNSAFE=<bool>]   (adds the extended injection case)
foreach(variable LORICA_CMAKE_DIR WORK_DIR GENERATOR CXX_COMPILER GROUP)
    if(NOT ${variable})
        message(FATAL_ERROR "build_refusals: ${variable} is required")
    endif()
endforeach()
set(inject "-DCMAKE_PROJECT_TOP_LEVEL_INCLUDES=${LORICA_CMAKE_DIR}/LoricaInject.cmake")
set(not_concrete "must be a concrete locally compiled target")
set(properties [=[file(GENERATE OUTPUT properties.txt CONTENT "$<TARGET_PROPERTY:app,LORICA_HARDENING_PROFILE>,$<TARGET_PROPERTY:app,LORICA_UNSAFE_APIS_DEPRECATED> $<TARGET_PROPERTY:lib,LORICA_HARDENING_PROFILE>,$<TARGET_PROPERTY:lib,LORICA_UNSAFE_APIS_DEPRECATED>")
add_library(lib STATIC main.cpp)]=])

# LR-BUILD-01 and LR-BUILD-02.
set(build_cases control missing_target interface imported alias custom unknown_argument
    unknown_platform c_only inject_no_targets inject_empty_targets inject_unknown_target
    inject_unknown_profile inject_removed injected)
set(control_lines "lorica_harden_target(app)")
set(missing_target_lines "lorica_harden_target(nosuch)")
set(missing_target_refusal "missing target nosuch")
set(interface_lines "add_library(iface INTERFACE)\nlorica_harden_target(iface)")
set(interface_refusal "${not_concrete}")
set(imported_lines "add_library(imp SHARED IMPORTED)\nlorica_harden_target(imp)")
set(imported_refusal "${not_concrete}")
set(alias_lines "add_library(lib STATIC main.cpp)\nadd_library(lib_alias ALIAS lib)\nlorica_harden_target(lib_alias)")
set(alias_refusal "${not_concrete}")
set(custom_lines "add_custom_target(custom)\nlorica_harden_target(custom)")
set(custom_refusal "${not_concrete}")
set(unknown_argument_lines "lorica_harden_target(app EXTENDE)")
set(unknown_argument_refusal "unknown lorica_harden_target arguments: EXTENDE")
set(unknown_platform_lines "set(CMAKE_SYSTEM_NAME Generic)\nunset(MSVC)\nlorica_harden_target(app)")
set(unknown_platform_refusal "unsupported hardening toolchain/platform; no silent fallback")
set(c_only_languages C)
set(c_only_source legacy.c)
set(c_only_lines "lorica_harden_target(app)")
set(c_only_refusal "the CXX language is not enabled")
set(inject_no_targets_arguments ${inject})
set(inject_no_targets_refusal "Lorica injection requires -DLORICA_TARGETS")
set(inject_empty_targets_arguments ${inject} -DLORICA_TARGETS=)
set(inject_empty_targets_refusal "${inject_no_targets_refusal}")
set(inject_unknown_target_arguments ${inject} -DLORICA_TARGETS=nosuch)
set(inject_unknown_target_refusal "missing target nosuch")
set(inject_unknown_profile_arguments ${inject} -DLORICA_TARGETS=app -DLORICA_PROFILE=max)
set(inject_unknown_profile_refusal "LORICA_PROFILE must be baseline or extended, not 'max'")
set(inject_removed_arguments ${inject} -DLORICA_TARGETS=app)
set(inject_removed_lines "set_property(GLOBAL PROPERTY LORICA_REQUESTED_TARGETS \"\")")
set(inject_removed_refusal "requested injection targets were removed")
# Every listed target, the default profile and no rejection unless asked.
set(injected_arguments ${inject} "-DLORICA_TARGETS=app\\;lib")
set(injected_lines "${properties}")
set(injected_properties "baseline, baseline,")
set(injected_extended_arguments ${inject} "-DLORICA_TARGETS=app\\;lib" -DLORICA_PROFILE=extended
    -DLORICA_DEPRECATE_UNSAFE_APIS=ON)
set(injected_extended_lines "${properties}")
set(injected_extended_properties "extended,TRUE extended,TRUE")
if(EXTENDED AND UNSAFE)
    list(APPEND build_cases injected_extended)
endif()

# LR-BUILD-04: refused at configuration with a readable message, or, for C sources
# the scan cannot see, stopped at build time by the header's #error.
set(unsafe_api_cases control precompiled_header reuse_from c_source language_property
    c_source_generator c_source_interface unsupported_toolchain mingw unknown_platform)
set(deprecate "lorica_deprecate_unsafe_apis(app)")
set(unsafe_api_control_lines "${deprecate}")
set(unsafe_api_precompiled_header_lines "${deprecate}\ntarget_precompile_headers(app PRIVATE <cstring>)")
set(unsafe_api_precompiled_header_refusal "uses precompiled headers")
set(unsafe_api_reuse_from_lines "${deprecate}\nadd_library(pch STATIC main.cpp)\ntarget_precompile_headers(pch PRIVATE <cstring>)\ntarget_precompile_headers(app REUSE_FROM pch)")
set(unsafe_api_reuse_from_refusal "uses precompiled headers")
set(unsafe_api_c_source_lines "${deprecate}\ntarget_sources(app PRIVATE legacy.c)")
set(unsafe_api_c_source_refusal "has C source legacy.c")
set(unsafe_api_language_property_lines "${deprecate}\ntarget_sources(app PRIVATE legacy.cc)\nset_source_files_properties(legacy.cc PROPERTIES LANGUAGE C)")
set(unsafe_api_language_property_refusal "has C source legacy.cc")
set(unsafe_api_c_source_generator_lines "${deprecate}\ntarget_sources(app PRIVATE \"$<BUILD_INTERFACE:\${CMAKE_CURRENT_SOURCE_DIR}/legacy.c>\")")
set(unsafe_api_c_source_generator_build_error "is a C\\+\\+ header")
set(unsafe_api_c_source_interface_lines "${deprecate}\nadd_library(dep INTERFACE)\ntarget_sources(dep INTERFACE \${CMAKE_CURRENT_SOURCE_DIR}/legacy.c)\ntarget_link_libraries(app PRIVATE dep)")
set(unsafe_api_c_source_interface_build_error "is a C\\+\\+ header")
set(unsafe_api_unsupported_toolchain_lines "set(_LORICA_PROBE_NO_CLANG_FORTIFY_OVERLOADS FALSE)\n${deprecate}")
set(unsafe_api_unsupported_toolchain_refusal "does not support Clang with glibc")
set(unsafe_api_mingw_lines "set(WIN32 1)\nunset(MSVC)\n${deprecate}")
set(unsafe_api_mingw_refusal "does not support MinGW")
set(unsafe_api_unknown_platform_lines "set(CMAKE_SYSTEM_NAME FreeBSD)\nunset(MSVC)\nunset(WIN32)\n${deprecate}")
set(unsafe_api_unknown_platform_refusal "does not support [A-Za-z]+ on FreeBSD")

# Control of this script: a case expecting a refusal that does not come.
set(harness_control_cases accepted)
set(harness_control_accepted_lines "lorica_harden_target(app)")
set(harness_control_accepted_refusal "a refusal that never comes")

foreach(case IN LISTS ${GROUP}_cases)
    set(key "${case}")
    if(NOT GROUP STREQUAL "build")
        set(key "${GROUP}_${case}")
    endif()
    set(languages C CXX)
    if(DEFINED ${key}_languages)
        set(languages ${${key}_languages})
    endif()
    set(source main.cpp)
    if(DEFINED ${key}_source)
        set(source ${${key}_source})
    endif()
    set(directory "${WORK_DIR}/${GROUP}/${case}")
    file(REMOVE_RECURSE "${directory}")
    file(WRITE "${directory}/main.cpp" "int main() { return 0; }\n")
    file(WRITE "${directory}/legacy.c" "#include <string.h>\nint legacy(char* b) { strcpy(b, \"a\"); return 0; }\n")
    file(WRITE "${directory}/legacy.cc" "int legacy(void) { return 0; }\n")
    file(WRITE "${directory}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)
project(refusal LANGUAGES ${languages})
include(\"${LORICA_CMAKE_DIR}/LoricaHardening.cmake\")
add_executable(app ${source})
${${key}_lines}
")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${directory}" -B "${directory}/build" -G "${GENERATOR}"
        "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}" -DCMAKE_BUILD_TYPE=Release ${${key}_arguments}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
    # CMake wraps long messages; compare without its line breaks.
    string(REGEX REPLACE "[ \t\r\n]+" " " flat "${output}")
    if(DEFINED ${key}_refusal)
        if(result EQUAL 0)
            message(FATAL_ERROR "${case} was accepted")
        elseif(NOT flat MATCHES "${${key}_refusal}")
            message(FATAL_ERROR "${case} failed without the refusal (${${key}_refusal}):\n${output}")
        endif()
        continue()
    elseif(NOT result EQUAL 0)
        message(FATAL_ERROR "${case} did not configure:\n${output}")
    endif()
    if(DEFINED ${key}_build_error)
        execute_process(COMMAND "${CMAKE_COMMAND}" --build "${directory}/build" --config Release
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
        if(result EQUAL 0)
            message(FATAL_ERROR "${case} was built")
        elseif(NOT output MATCHES "${${key}_build_error}")
            message(FATAL_ERROR "${case} failed to build without ${${key}_build_error}:\n${output}")
        endif()
    elseif(DEFINED ${key}_properties)
        file(READ "${directory}/build/properties.txt" applied)
        if(NOT applied STREQUAL "${${key}_properties}")
            message(FATAL_ERROR "${case} applied '${applied}', not '${${key}_properties}'")
        endif()
    endif()
endforeach()
