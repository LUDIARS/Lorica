# SPEC-LR-VERIFY: tools/verify_binary.py (LR-ARTIFACT-01). The unit tests feed it PE
# bytes and canned readelf text and check its exit codes. On Linux it must accept a
# test executable lorica_harden_target built, and fixtures linked here with exactly
# one property missing must be rejected for that property.
function(lorica_add_verifier_tests)
    add_test(NAME lorica.verify_binary.unit
        COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tests/test_verify_binary.py)
    if(NOT (CMAKE_SYSTEM_NAME STREQUAL "Linux" OR (MSVC AND CMAKE_SIZEOF_VOID_P EQUAL 8)))
        return()
    endif()
    set(lorica_verify ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tools/verify_binary.py)
    add_test(NAME lorica.verify_binary.hardened COMMAND ${lorica_verify} $<TARGET_FILE:lorica_boundary_tests>)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        return()
    endif()
    set(directory "${CMAKE_CURRENT_BINARY_DIR}/verify_binary")
    file(CONFIGURE OUTPUT "${directory}/main.cpp" CONTENT "int main() { return 0; }\n" @ONLY)
    file(CONFIGURE OUTPUT "${directory}/library.cpp" CONTENT "int lorica_fixture() { return 0; }\n" @ONLY)
    set(full -Wl,-z,relro,-z,now,-z,noexecstack)
    set(full_options -pie ${full})
    set(no_pie_options -no-pie ${full})
    set(no_pie_rejection "executable is not position independent")
    set(executable_stack_options -pie ${full} -Wl,-z,execstack)
    set(executable_stack_rejection "non-executable GNU_STACK required")
    set(no_relro_options -pie ${full} -Wl,-z,norelro)
    set(no_relro_rejection "full RELRO requires GNU_RELRO and immediate binding")
    set(lazy_binding_options -pie ${full} -Wl,-z,lazy)
    set(lazy_binding_rejection "${no_relro_rejection}")
    set(shared_library_options ${full})
    set(shared_library_rejection "ELF PIE executable marker missing")
    foreach(name IN ITEMS full no_pie executable_stack no_relro lazy_binding shared_library)
        set(target lorica_elf_fixture_${name})
        if(name STREQUAL "shared_library")
            add_library(${target} SHARED "${directory}/library.cpp")
        else()
            add_executable(${target} "${directory}/main.cpp")
            target_compile_options(${target} PRIVATE $<IF:$<STREQUAL:${name},no_pie>,-fno-pie,-fPIE>)
        endif()
        target_link_options(${target} PRIVATE ${${name}_options})
        add_test(NAME lorica.verify_binary.elf.${name} COMMAND ${lorica_verify} $<TARGET_FILE:${target}>)
        if(DEFINED ${name}_rejection)
            set_tests_properties(lorica.verify_binary.elf.${name} PROPERTIES
                PASS_REGULAR_EXPRESSION "Lorica verification failed: ${${name}_rejection}")
        endif()
    endforeach()
endfunction()
