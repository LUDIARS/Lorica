# SPEC-LR-VERIFY: external injection (LR-BUILD-02). A project that does not know
# Lorica is configured through LoricaInject.cmake. The valid cases must leave the
# requested profile on the listed target, read back after the injection ran; a
# missing or empty allowlist, an unknown or imported target and an unknown profile
# must fail configuration with the refusal. Run with cmake -P:
#   -DLORICA_CMAKE_DIR=<cmake dir> -DWORK_DIR=<scratch> -DGENERATOR=<generator>
#   -DCXX_COMPILER=<compiler> [-DEXTENDED=ON] [-DUNSAFE_API=ON]
foreach(variable LORICA_CMAKE_DIR WORK_DIR GENERATOR CXX_COMPILER)
    if(NOT ${variable})
        message(FATAL_ERROR "inject_refusals: ${variable} is required")
    endif()
endforeach()
set(cases baseline no_targets empty_targets unknown_target imported_target unknown_profile)
set(baseline_arguments -DLORICA_TARGETS=app)
set(baseline_expect "injected: profile=baseline deprecated=;")
set(no_targets_refusal "requires -DLORICA_TARGETS")
set(empty_targets_arguments -DLORICA_TARGETS=)
set(empty_targets_refusal "requires -DLORICA_TARGETS")
set(unknown_target_arguments -DLORICA_TARGETS=absent)
set(unknown_target_refusal "missing target absent")
set(imported_target_arguments -DLORICA_TARGETS=prebuilt)
set(imported_target_refusal "prebuilt must be a concrete locally compiled target")
set(unknown_profile_arguments -DLORICA_TARGETS=app -DLORICA_PROFILE=strict)
set(unknown_profile_refusal "must be baseline or extended")
if(EXTENDED)
    list(APPEND cases extended)
    set(extended_arguments -DLORICA_TARGETS=app -DLORICA_PROFILE=extended)
    set(extended_expect "injected: profile=extended deprecated=;")
endif()
if(UNSAFE_API)
    list(APPEND cases deprecated)
    set(deprecated_arguments -DLORICA_TARGETS=app -DLORICA_DEPRECATE_UNSAFE_APIS=ON)
    set(deprecated_expect "injected: profile=baseline deprecated=TRUE;")
endif()
foreach(case IN LISTS cases)
    set(source "${WORK_DIR}/${case}")
    file(REMOVE_RECURSE "${source}")
    file(WRITE "${source}/main.cpp" "int main() { return 0; }\n")
    file(WRITE "${source}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)
project(injected LANGUAGES CXX)
add_executable(app main.cpp)
add_library(prebuilt STATIC IMPORTED)
# Deferred calls run in the order they were made: this one after the injection.
function(report)
    get_property(profile TARGET app PROPERTY LORICA_HARDENING_PROFILE)
    get_property(deprecated TARGET app PROPERTY LORICA_UNSAFE_APIS_DEPRECATED)
    message(STATUS \"injected: profile=\${profile} deprecated=\${deprecated};\")
endfunction()
cmake_language(DEFER CALL report)
")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${source}/build" -G "${GENERATOR}"
        "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}" -DCMAKE_BUILD_TYPE=Release
        "-DCMAKE_PROJECT_TOP_LEVEL_INCLUDES=${LORICA_CMAKE_DIR}/LoricaInject.cmake" ${${case}_arguments}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
    string(REGEX REPLACE "[ \t\r\n]+" " " flat "${output}")
    if(DEFINED ${case}_refusal)
        if(result EQUAL 0)
            message(FATAL_ERROR "${case} was accepted")
        elseif(NOT flat MATCHES "${${case}_refusal}")
            message(FATAL_ERROR "${case} failed without the refusal (${${case}_refusal}):\n${output}")
        endif()
    elseif(NOT result EQUAL 0)
        message(FATAL_ERROR "${case} did not configure:\n${output}")
    else()
        string(FIND "${flat}" "${${case}_expect}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "${case} configured without '${${case}_expect}':\n${output}")
        endif()
    endif()
endforeach()
