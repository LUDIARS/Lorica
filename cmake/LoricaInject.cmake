# Pass via CMAKE_PROJECT_TOP_LEVEL_INCLUDES. Runs after the consuming project
# has declared its targets. A required allowlist prevents a silent no-op.
#   -DLORICA_TARGETS=a;b               targets to harden (required)
#   -DLORICA_PROFILE=baseline|extended  hardening profile (default baseline)
#   -DLORICA_DEPRECATE_UNSAFE_APIS=ON   also reject unbounded C copy/format APIs
#                                      (every deprecation becomes an error; see
#                                      SPEC-LR-UNSAFE-API for refused targets)
#   -DLORICA_CONTRACT_SEMANTIC=ignore|observe|enforce|quick_enforce
#                                      evaluation semantic of the targets' contracts
#                                      (ignore strips them; see SPEC-LR-CONTRACTS)
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/LoricaHardening.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/LoricaContracts.cmake")
if(NOT LORICA_TARGETS)
    message(FATAL_ERROR "Lorica injection requires -DLORICA_TARGETS=target1;target2")
endif()
if(NOT DEFINED LORICA_PROFILE)
    set(LORICA_PROFILE baseline)
endif()
if(NOT LORICA_PROFILE MATCHES "^(baseline|extended)$")
    message(FATAL_ERROR "Lorica: LORICA_PROFILE must be baseline or extended, not '${LORICA_PROFILE}'")
endif()
set_property(GLOBAL PROPERTY LORICA_REQUESTED_TARGETS "${LORICA_TARGETS}")
set_property(GLOBAL PROPERTY LORICA_REQUESTED_PROFILE "${LORICA_PROFILE}")
set_property(GLOBAL PROPERTY LORICA_REQUESTED_DEPRECATION "${LORICA_DEPRECATE_UNSAFE_APIS}")
set_property(GLOBAL PROPERTY LORICA_REQUESTED_CONTRACT_SEMANTIC "${LORICA_CONTRACT_SEMANTIC}")
function(_lorica_apply_requested)
    get_property(requested GLOBAL PROPERTY LORICA_REQUESTED_TARGETS)
    get_property(profile GLOBAL PROPERTY LORICA_REQUESTED_PROFILE)
    get_property(deprecate GLOBAL PROPERTY LORICA_REQUESTED_DEPRECATION)
    get_property(semantic GLOBAL PROPERTY LORICA_REQUESTED_CONTRACT_SEMANTIC)
    if(NOT requested)
        message(FATAL_ERROR "Lorica: requested injection targets were removed")
    endif()
    set(extended)
    if(profile STREQUAL "extended")
        set(extended EXTENDED)
    endif()
    foreach(target IN LISTS requested)
        lorica_harden_target("${target}" ${extended})
        if(deprecate)
            lorica_deprecate_unsafe_apis("${target}")
        endif()
        if(NOT semantic STREQUAL "")
            lorica_set_contract_semantic("${target}" "${semantic}")
        endif()
    endforeach()
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _lorica_apply_requested)
