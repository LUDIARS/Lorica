@PACKAGE_INIT@
set_and_check(LORICA_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
include("${CMAKE_CURRENT_LIST_DIR}/LoricaTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/LoricaHardening.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/LoricaContracts.cmake")
set_property(GLOBAL PROPERTY LORICA_UNSAFE_API_HEADER "${LORICA_INCLUDE_DIR}/lorica/unsafe_api.hpp")
# Components are the installed targets: boundary, and protection and contracts
# where they were built.
foreach(_lorica_component IN ITEMS boundary protection contracts)
    if(TARGET Lorica::${_lorica_component})
        set(Lorica_${_lorica_component}_FOUND TRUE)
    endif()
endforeach()
check_required_components(Lorica)
