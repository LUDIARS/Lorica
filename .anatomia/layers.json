{
  "mergeCouplingThreshold": 1,
  "layers": [
    {"glob": "include/lorica/**", "layer": "domain"},
    {"glob": "src/**", "layer": "infrastructure"},
    {"glob": "cmake/**", "layer": "infrastructure"},
    {"glob": "tools/**", "layer": "infrastructure"},
    {"glob": "tests/**", "layer": "verification"},
    {"glob": "examples/**", "layer": "application"},
    {"glob": "CMakeLists.txt", "layer": "infrastructure"}
  ],
  "allow": {
    "domain": [],
    "infrastructure": ["domain"],
    "application": ["domain"],
    "verification": ["domain", "infrastructure", "application"]
  }
}
